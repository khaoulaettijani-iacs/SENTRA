# SENTRA - Configuration d'Environnement

# --- Elasticsearch & ELK ---
ES_HOST=http://elasticsearch:9200
# (Optionnel si tu décides d'activer la sécurité Elastic plus tard)
# ELASTIC_PASSWORD=your_elastic_password 

# --- PostgreSQL (Case Management) ---
POSTGRES_DB=sentra
POSTGRES_USER=sentra_app
POSTGRES_PASSWORD=change_me_to_a_strong_password
DATABASE_URL=postgresql://sentra_app:${POSTGRES_PASSWORD}@postgres:5432/sentra

# --- Cyber Threat Intelligence (CTI) ---
# Clé API pour l'enrichissement de la réputation des IPs
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# --- Notifications (Discord Webhook) ---
# URL du Webhook Discord pour recevoir les alertes critiques
WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# --- Notifications (Email - Optionnel) ---
# Configuration SMTP pour l'envoi de rapports
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
NOTIFY_EMAIL_TO=analyst@example.com

# --- URLs des APIs internes SENTRA ---
ML_API=http://backend-api:8000
RISK_API=http://risk-scoring-engine:8000
CASE_API_URL=http://case-management-api:8000/incidents