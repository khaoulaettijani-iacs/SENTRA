# SECRETS & CREDENTIALS 
.env

# DOCKER & DATA VOLUMES
esdata/
**/esdata/
volumes/
pgdata/

# PYTHON & CACHE
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

#  MACHINE LEARNING (DATA & MODELS)

# Ignorer les gros datasets CSV
ml/data/raw/*.csv
ml/data/raw/

# Ignorer tous les modèles par défaut
ml/models/*.pkl
ml/models/*.json

# MAIS forcer l'inclusion des modèles v2 pour la production SOC (Whitelist)
!ml/models/*_v2_lean.pkl
!ml/models/scaler_v2.pkl
!ml/models/feature_columns_v2.json
!ml/models/.gitkeep

#  ENRICHISSEMENT & RAPPORTS
enrichment/data/*.mmdb
reporting/output/


