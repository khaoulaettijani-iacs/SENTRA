# Détection scan XMAS 
alert tcp any any -> $HOME_NET any (msg:"SENTRA CUSTOM Suspicious TCP Scan Flags (Xmas)"; flags:FPU+; classtype:attempted-recon; sid:9000001; rev:2;)

# Brute-force SSH
alert tcp any any -> $HOME_NET 22 (msg:"SENTRA CUSTOM SSH Brute Force Attempt"; flow:to_server; flags:S; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:9000002; rev:2;)

# Scan web (Gobuster)
alert http $HOME_NET any -> any any (msg:"SENTRA CUSTOM Web Directory Bruteforce Attempt"; flow:to_client,established; http.stat_code; content:"404"; threshold:type both, track by_dst, count 20, seconds 30; classtype:web-application-attack; sid:9000003; rev:2;)