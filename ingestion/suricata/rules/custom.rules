# 1. Détection scan XMAS (FIN, PSH, URG allumés. SYN, RST, ACK éteints)
alert tcp any any -> 192.168.20.10 any (msg:"SENTRA CUSTOM Suspicious TCP Scan Flags (Xmas)"; flags:FPU,AKRS; classtype:attempted-recon; sid:9000001; rev:4;)

# 2. Brute-force SSH (Correspond au 9000002 dans ton YAML : T1110.001)
alert tcp any any -> any 22 (msg:"[SENTRA] CUSTOM SSH Brute Force Attempt"; flags:S; threshold: type both, track by_src, count 5, seconds 10; classtype:attempted-login; priority:1; sid:9000002; rev:2;)

# 3. Web Directory Bruteforce (Correspond au 9000003 dans ton YAML : T1595.003)
alert http any any -> any 80 (msg:"[SENTRA] CUSTOM Web Directory Bruteforce Attempt"; content:"Gobuster"; http_user_agent; classtype:web-application-attack; priority:1; sid:9000003; rev:2;)

# 4. Détection scan FIN (Uniquement FIN allumé. Tous les autres éteints)
alert tcp any any -> 192.168.20.10 any (msg:"SENTRA CUSTOM Suspicious TCP Scan Flags (FIN)"; flags:F,PUAKRS; classtype:attempted-recon; sid:9000004; rev:1;)

# 5. Détection scan NULL (Aucun flag allumé)
alert tcp any any -> 192.168.20.10 any (msg:"SENTRA CUSTOM Suspicious TCP Scan Flags (NULL)"; flags:0,FPUAKRS; classtype:attempted-recon; sid:9000005; rev:1;)